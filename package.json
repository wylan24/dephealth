{
  "name": "dephealth",
  "version": "0.3.0",
  "description": "Dependency health report for npm and Python projects: insecure, abandoned, outdated and heavier-than-needed packages, with scores, fixes and replacement suggestions.",
  "type": "module",
  "bin": {
    "dephealth": "dist/cli.js"
  },
  "files": [
    "action.yml",
    "data",
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "node src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "audit",
    "cli",
    "dependencies",
    "deprecated",
    "libyear",
    "npm",
    "osv",
    "outdated",
    "poetry",
    "pypi",
    "python",
    "requirements",
    "security",
    "uv"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wylan24/dephealth.git"
  },
  "dependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "esbuild": "^0.28.2",
    "module-replacements": "^3.4.0",
    "semver": "^7.7.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/semver": "^7.7.0",
    "typescript": "^7.0.2"
  },
  "author": "wylan24",
  "homepage": "https://github.com/wylan24/dephealth#readme",
  "bugs": {
    "url": "https://github.com/wylan24/dephealth/issues"
  }
}
